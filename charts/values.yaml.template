byohImage: __CONTROLLER_IMAGE__
resources:
  limits:
    cpu: 200m
    memory: 500Mi
  requests:
    cpu: 100m
    memory: 250Mi
byohostAgentHeartbeatTimeout: 120s

# The https endpoint a BYO host dials to reach this management cluster, as
# https://<host>:<port>. Required: the controller manager refuses to start
# without it. Must pass TLS through, because a proxy that terminates TLS strips
# the client certificate the host later presents.
bootstrapAPIServerURL: ""
