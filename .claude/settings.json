{
  "permissions": {
    "allow": [
      "Bash(make test *)",
      "Bash(make test-coverage *)",
      "Bash(make test-e2e-linux-vm *)",
      "Bash(make test-packaging-linux-vm *)",
      "Bash(make cmd-test *)",
      "Bash(make agent-test *)",
      "Bash(make agent-test-linux-vm *)",
      "Bash(make -n test-e2e-linux-vm)",
      "Bash(make lint *)",
      "Bash(make fmt *)",
      "Bash(make vet *)",
      "Bash(make generate *)",
      "Bash(make manifests *)",
      "Bash(make build *)",
      "Bash(make build-host-agent-rpm *)",
      "Bash(make build-host-agent-rpm-linux-vm *)",
      "Bash(make build-host-agent-deb-linux-vm *)",
      "Bash(make clean *)",
      "Bash(make help *)",
      "Bash(make patch-coverage *)",
      "Bash(gh run *)",
      "Bash(gh pr view *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/dev/patch-coverage-hook.sh",
            "timeout": 300,
            "statusMessage": "Checking patch coverage"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/dev/patch-coverage-hook.sh",
            "timeout": 300,
            "statusMessage": "Checking patch coverage"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(make test-e2e*)",
        "hooks": [
          {
            "type": "command",
            "command": "podman system prune -a --volumes -f 2>/dev/null || docker system prune -a --volumes -f",
            "statusMessage": "Reclaiming disk space"
          }
        ]
      }
    ]
  }
}
